# API
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_agents

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXECUTIONS_QUEUE=agent-executions
RABBITMQ_PREFETCH=5

# Worker
# Latência simulada do processamento de uma execução (ms)
PROCESSING_DELAY_MS=2000
